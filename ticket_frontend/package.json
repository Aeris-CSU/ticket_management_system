    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.2.2",
